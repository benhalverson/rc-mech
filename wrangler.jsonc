{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rc-mech",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "directory": "./public", "binding": "ASSETS" },
	"routes": [
		{
			"pattern": "chassisnotes.com",
			"zone_name": "chassisnotes.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		},
		{
			"pattern": "www.chassisnotes.com",
			"zone_name": "chassisnotes.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"send_email": [{ "name": "EMAIL" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rc-mech",
			"database_id": "97219482-4250-4c83-9785-7886a8b3a434",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "rc-mech-photos" }],
	"vars": { "ENVIRONMENT": "production" },
	"env": {
		"local": {
			"routes": [],
			"assets": { "directory": "./public", "binding": "ASSETS" },
			"send_email": [{ "name": "EMAIL" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rc-mech",
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "rc-mech-photos" }],
			"vars": { "APP_URL": "http://localhost:8787", "ENVIRONMENT": "local" }
		}
	},
	"observability": { "enabled": true }
}
