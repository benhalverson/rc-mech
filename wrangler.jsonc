{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rc-mech",
	"main": "prototypes/issue-230/worker.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "directory": "./public", "binding": "ASSETS" },
	"routes": [
		{
			"pattern": "chassisnotes.com",
			"zone_name": "chassisnotes.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		},
		{
			"pattern": "www.chassisnotes.com",
			"zone_name": "chassisnotes.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"send_email": [{ "name": "EMAIL" }],
	"ai": { "binding": "AI" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rc-mech",
			"database_id": "97219482-4250-4c83-9785-7886a8b3a434",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "rc-mech-photos" }],
	"containers": [
		{
			"class_name": "Issue230PythonContainer",
			"image": "./prototypes/issue-230/python/Dockerfile",
			"instance_type": "lite",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ISSUE_230_PYTHON_CONTAINER",
				"class_name": "Issue230PythonContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "issue-230-v1",
			"new_sqlite_classes": ["Issue230PythonContainer"]
		}
	],
	"vars": { "ENVIRONMENT": "production" },
	"env": {
		"local": {
			"routes": [],
			"assets": { "directory": "./public", "binding": "ASSETS" },
			"send_email": [{ "name": "EMAIL" }],
			"ai": { "binding": "AI", "remote": true },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rc-mech",
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "rc-mech-photos" }],
			"containers": [
				{
					"class_name": "Issue230PythonContainer",
					"image": "./prototypes/issue-230/python/Dockerfile",
					"instance_type": "lite",
					"max_instances": 1
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "ISSUE_230_PYTHON_CONTAINER",
						"class_name": "Issue230PythonContainer"
					}
				]
			},
			"migrations": [
				{
					"tag": "issue-230-v1",
					"new_sqlite_classes": ["Issue230PythonContainer"]
				}
			],
			"vars": { "APP_URL": "http://localhost:8787", "ENVIRONMENT": "local" }
		}
	},
	"observability": { "enabled": true }
}
