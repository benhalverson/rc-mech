{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rc-mech",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": { "crons": ["0 */6 * * *"] },
	"assets": { "directory": "./public", "binding": "ASSETS" },
	"routes": [
		{
			"pattern": "chassisnotes.com",
			"zone_name": "chassisnotes.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		},
		{
			"pattern": "www.chassisnotes.com",
			"zone_name": "chassisnotes.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"send_email": [{ "name": "EMAIL" }],
	"ai": { "binding": "AI" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rc-mech",
			"database_id": "97219482-4250-4c83-9785-7886a8b3a434",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{ "binding": "PHOTOS", "bucket_name": "rc-mech-photos" },
		{
			"binding": "ANALYSIS_MEDIA",
			"bucket_name": "rc-mech-analysis-media"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "GPU_LEASE_COORDINATOR", "class_name": "GpuLeaseCoordinator" },
			{
				"name": "RACE_VIDEO_MEDIA_CONTAINER",
				"class_name": "RaceVideoMediaContainer"
			}
		]
	},
	"containers": [
		{
			"name": "rc-mech-driving-analysis-media",
			"class_name": "RaceVideoMediaContainer",
			"image": "./containers/driving-analysis/Dockerfile",
			"image_build_context": "./containers/driving-analysis",
			"instance_type": "standard-4",
			"max_instances": 2
		}
	],
	"workflows": [
		{
			"binding": "DRIVING_ANALYSIS_WORKFLOW",
			"name": "rc-mech-driving-analysis",
			"class_name": "DrivingAnalysisWorkflow"
		},
		{
			"binding": "RACE_VIDEO_VALIDATION_WORKFLOW",
			"name": "rc-mech-race-video-validation",
			"class_name": "RaceVideoValidationWorkflow"
		}
	],
	"migrations": [
		{
			"tag": "v1-gpu-lease-coordinator",
			"new_sqlite_classes": ["GpuLeaseCoordinator"]
		},
		{
			"tag": "v2-race-video-media-container",
			"new_sqlite_classes": ["RaceVideoMediaContainer"]
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"GPU_PROVIDER_ORIGIN": "https://gpu.chassisnotes.com"
	},
	"env": {
		"local": {
			"routes": [],
			"assets": { "directory": "./public", "binding": "ASSETS" },
			"send_email": [{ "name": "EMAIL" }],
			"ai": { "binding": "AI", "remote": true },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rc-mech",
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{ "binding": "PHOTOS", "bucket_name": "rc-mech-photos" },
				{
					"binding": "ANALYSIS_MEDIA",
					"bucket_name": "rc-mech-analysis-media"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "GPU_LEASE_COORDINATOR",
						"class_name": "GpuLeaseCoordinator"
					},
					{
						"name": "RACE_VIDEO_MEDIA_CONTAINER",
						"class_name": "RaceVideoMediaContainer"
					}
				]
			},
			"containers": [
				{
					"name": "rc-mech-driving-analysis-media-local",
					"class_name": "RaceVideoMediaContainer",
					"image": "./containers/driving-analysis/Dockerfile",
					"image_build_context": "./containers/driving-analysis",
					"instance_type": "standard-4",
					"max_instances": 2
				}
			],
			"workflows": [
				{
					"binding": "DRIVING_ANALYSIS_WORKFLOW",
					"name": "rc-mech-driving-analysis-local",
					"class_name": "DrivingAnalysisWorkflow"
				},
				{
					"binding": "RACE_VIDEO_VALIDATION_WORKFLOW",
					"name": "rc-mech-race-video-validation-local",
					"class_name": "RaceVideoValidationWorkflow"
				}
			],
			"migrations": [
				{
					"tag": "v1-gpu-lease-coordinator",
					"new_sqlite_classes": ["GpuLeaseCoordinator"]
				},
				{
					"tag": "v2-race-video-media-container",
					"new_sqlite_classes": ["RaceVideoMediaContainer"]
				}
			],
			"vars": {
				"APP_URL": "http://localhost:8787",
				"ENVIRONMENT": "local",
				"GPU_PROVIDER_ORIGIN": "https://gpu.invalid"
			}
		}
	},
	"observability": { "enabled": true }
}
