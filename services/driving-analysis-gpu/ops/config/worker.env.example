# Non-secret values only. Access tokens, R2 signing keys, D1 credentials, and
# Worker application credentials must never be placed in this file or on host.
GPU_WORKER_STATE_ROOT=/var/lib/chassis-notes-gpu
GPU_INFERENCE_PROFILE_PATH=/etc/chassis-notes-gpu/profile.json
SAM31_CHECKPOINT_PATH=/models/sam3.1.pt
GPU_WATCHDOG_SECONDS=120
GPU_TRANSFER_TIMEOUT_SECONDS=1800
GPU_RETENTION_SECONDS=86400
GPU_MAX_INPUT_BYTES=53687091200
GPU_MAX_OUTPUT_BYTES=67108864
