{
  "name": "rc-mech",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "client:build": "pnpm --dir client build",
    "client:watch": "pnpm --dir client watch",
    "worker:dev": "wrangler dev",
    "dev": "concurrently --kill-others-on-fail \"pnpm client:watch\" \"pnpm worker:dev\"",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check:client": "pnpm --dir client build",
    "check": "tsc --noEmit && pnpm check:client && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@scalar/hono-api-reference": "^0.11.12",
    "better-auth": "^1.6.25",
    "chanfana": "^2.6.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "22.13.0",
    "@types/service-worker-mock": "^2.0.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.118.0"
  }
}
