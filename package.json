{
	"name": "rc-mech",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "pnpm client:build && pnpm db:migrate:production && wrangler deploy",
		"client:build": "pnpm --dir client build",
		"client:dev": "pnpm --dir client start",
		"worker:dev": "wrangler dev --env local",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --env local",
		"db:migrate:production": "wrangler d1 migrations apply DB --remote",
		"db:seed-invite": "tsx scripts/invite-cli.ts",
		"test:invite:request": "bash scripts/invite-request-smoke.sh",
		"test:invite:browser": "playwright test -c playwright.config.ts",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format --reporter=summary .",
		"test:backend": "vitest run",
		"test:auth:e2e": "bash scripts/auth-flow-smoke.sh",
		"test:production": "bash scripts/production-acceptance.sh",
		"check:client": "pnpm --dir client build && pnpm --dir client exec ng test --watch=false --no-progress",
		"check": "tsc --noEmit && pnpm check:client && wrangler deploy --dry-run"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.25",
		"@better-auth/passkey": "^1.6.25",
		"@scalar/hono-api-reference": "^0.11.12",
		"better-auth": "^1.6.25",
		"chanfana": "^2.6.3",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.6.20",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@cloudflare/workers-types": "^5.20260801.1",
		"@playwright/test": "^1.62.1",
		"@types/node": "22.13.0",
		"@types/service-worker-mock": "^2.0.4",
		"axe-playwright": "^2.2.2",
		"commander": "^15.0.0",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.23.10",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"wrangler": "^4.118.0"
	}
}
